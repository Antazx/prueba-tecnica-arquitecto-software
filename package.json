{
  "name": "diagnostic-appointments",
  "version": "0.1.0",
  "private": true,
  "description": "Diagnostic appointment scheduling service",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "build": "tsc",
    "start:api": "node --env-file-if-exists=.env dist/bootstrap/api.js",
    "start:worker": "node --env-file-if-exists=.env dist/bootstrap/worker.js",
    "dev:api": "node --watch --env-file-if-exists=.env src/bootstrap/api.ts",
    "dev:worker": "node --watch --env-file-if-exists=.env src/bootstrap/worker.ts",
    "check:connections": "node --env-file-if-exists=.env src/bootstrap/check-connections.ts",
    "recover:message": "node --env-file-if-exists=.env src/bootstrap/recover-message.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.4",
    "amqplib": "2.3.1",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
