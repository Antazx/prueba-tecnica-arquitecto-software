# Local synthetic environment only; not production credentials.
DATABASE_URL=postgresql://diagnostic:diagnostic_dev@127.0.0.1:5432/diagnostic_appointments
RABBITMQ_URL=amqp://diagnostic:diagnostic_dev@127.0.0.1:5672?heartbeat=10
HOST=127.0.0.1
API_PORT=3000
WORKER_HEALTH_PORT=3001

# Hold deadline may be shortened for local demonstrations; maximum 600000 ms.
DIRECT_HOLD_TTL_MS=600000
EXPIRY_SWEEP_INTERVAL_MS=3000
# Enable exactly one relay (Compose sets true on its single worker). Replicas use false.
RELAY_ENABLED=false
OFFER_MAXIMUM_MS=7200000
# Override for isolated parallel Compose projects.
APPLICATION_IMAGE=recoletas-diagnostic-appointments:local
